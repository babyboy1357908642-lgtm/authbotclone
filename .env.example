# Obtain a new token from @BotFather. Never share your populated .env.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user IDs, comma-separated. At least one required.
ADMIN_IDS=
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=waifu_cards

# Bootstrap trusted channels; /sources add can also configure them.
ALLOWED_CHANNEL_IDS=
DEFAULT_CATALOG=default
COLLECTOR_ENABLED=true

MAX_DOWNLOAD_MB=15
MAX_IMAGE_PIXELS=24000000
HASH_DISTANCE=8
HASH_MARGIN=3
LOOKUP_CONCURRENCY=4
LOOKUP_COOLDOWN_SECONDS=2
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=5000
JOB_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
